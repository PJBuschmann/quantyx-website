# --- Browser (baked into the build) ---
# Endpoint the contact form POSTs its JSON payload to.
# On Vercel use the built-in function: VITE_CONTACT_ENDPOINT=/api/contact
# Leave unset and the form falls back to opening the visitor's mail client.
VITE_CONTACT_ENDPOINT=

# --- Server only (api/contact.js; set in Vercel, never exposed to the browser) ---
# Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=
# Optional overrides.
# CONTACT_TO=info@quantyx.com
# CONTACT_FROM=Quantyx Website <website@quantyx.com>
